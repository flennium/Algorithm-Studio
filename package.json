{
  "name": "algorithm-studio",
  "version": "1.0.0",
  "private": true,
  "description": "A desktop interpreter and learning environment for Algorithm pseudocode.",
  "author": "Algorithm Studio",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && npm test && electron-vite build",
    "build:web": "npm run typecheck && npm test && vite build --config vite.web.config.ts",
    "dev:web": "vite --config vite.web.config.ts",
    "dist": "npm run build && electron-builder --win nsis --publish never",
    "preview": "electron-vite preview",
    "preview:web": "vite preview --config vite.web.config.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json"
  },
  "dependencies": {
    "@monaco-editor/react": "4.7.0",
    "lucide-react": "1.47.0",
    "monaco-editor": "0.53.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "^5.0.1",
    "electron": "44.4.3",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "7.3.6",
    "vitest": "5.0.1"
  },
  "build": {
    "appId": "com.algorithmstudio.desktop",
    "productName": "Algorithm Studio",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "Algorithm-Studio-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
